optimization TestSimple(objectiveIntegrand=ObjInt, startTime=0, finalTime=startTime+1, timeStep=3600, intervalLengths="336*1", tolerance=1e-1, truncationDelta=1e-2)
	extends IOCSmod.Optimization.TestSimple(addDummyEquation=false,
											sim.filNam=Modelica.Utilities.Files.loadResource("modelica://IOCSmod/Resources/weatherdata//BEL_VLG_Uccle.064470_TMYx.2007-2021.mos"),
											priceSim.path_economic_params_json="/mnt/software/IOCShub/COSINE/input_data/economic_params.json",
                                            priceSim.path_dynamic_elec_prices=Modelica.Utilities.Files.loadResource("modelica://IOCSmod/Resources/ElectricityPrices/2025_Dynamic_consumer_prices.txt"),
                                            priceSim.use_dyn_elec_p=false,
											hea.u=uHea
											);

	// Optimisation variables
	// Already included in the models

	input Real uHea(free=true, min=-1, max=1, nominal=1/300000, start=0);
	//output Real uHea = uHeaTable.y[1];

	////////////////////////////////
	// Demand Output variables    //
	////////////////////////////////
	output Real tOut = time;
	output Real QvolProbe = pulse.y;

	output Real Tvol = vol.T - 273.15;
	output Real Qvol = vol.heatPort.Q_flow;
	output Real TvolIn = senTVolIn.T - 273.15;
	output Real TvolOut = senTVolOut.T - 273.15;
	
	output Real TSetHea = 40;
	output Real TSetCoo = 50;
	output Real DiscmfHeaVol = max(0,	TSetHea - Tvol);
	output Real DiscmfCooVol = max(0, Tvol - TSetCoo);
	

	// Tank
	output Real Ttank = tan.vol.T - 273.15; //°C
	output Real Vtank = tan.VTan;
	
	// Heater
	output Real THeaIn = senTHeaIn.T -273.15;
	output Real THeaOut = senTHeaOut.T -273.15;
	output Real QHea = hea.Q_flow;
	output Real mFlowHea = hea.m_flow;
	output Real n1 = -0.0645; // first COP coeff
	output Real n2 = 0.395; // second COP coeff
	output Real COPHea = n1 + n2 / (1 - (sim.Te/tan.vol.T));
	output Real PHea = QHea/COPHea;


	// temperature data for COP calculation	
	output Real T_COP_Sup = Ttank; 			// Temperatures should be in °C


	// Electricity prices
	output Real elecPriceOfftake = priceSim.priceBus.elec_offtake_price; // Prices should be in €/MWh
	output Real elecPriceInjection = priceSim.priceBus.elec_inj_price; // Prices should be in €/MWh

	// overall result data:
	output Real DiscmfHea = DiscmfHeaVol; // Heating discomort in Kh
	output Real DiscmfCoo = DiscmfCooVol; // Cooling discomfort in Kh
	output Real ElecUse = TotalPower; // Overall energy use of the entire district (buildings + energy hub), offtake should be positive
	

	///////////////////////////////////
	// Objective function definition //
	///////////////////////////////////

	/// Electricity ///
	output Real TotalPower = PHea;

	output Real tariff_scaler = 36000000;
	output Real p_offtake = priceSim.priceBus.elec_offtake_price/(3600*1e6);
	output Real p_offtakeSca = p_offtake * tariff_scaler;
	output Real p_inj = priceSim.priceBus.elec_inj_price/(3600*1e6);
	output Real p_injSca = p_inj * tariff_scaler;
	output Real b = 50;
	output Real smoothPrice = p_injSca + (p_offtakeSca - p_injSca) * 0.5 *(1 + TotalPower / (sqrt(TotalPower^2 + b^2)) );

	output Real ObjIntElecCost = TotalPower*smoothPrice;


	// Supply temperature	
	output Real TSupMax = 60;
	output Real ObjIntTSupMax = 10000*max(0, Ttank - TSupMax)^2;
	output Real TSupMin = 5;
	output Real ObjIntTSupMin = 10000*max(0, TSupMin - Ttank)^2;


	/// Comfort ///
	output Real weight_hea = 10000;
	output Real weight_coo = 10000;
	
	output Real ObjIntComfSHea = weight_hea*(DiscmfHea^2); /// Kh/jaar
	output Real ObjIntComfSCoo = weight_coo*(DiscmfCoo^2);
	

	/// Overall objective ///
	output Real ObjInt = ObjIntElecCost + ObjIntComfSCoo + ObjIntComfSHea + ObjIntTSupMax + ObjIntTSupMin;


end TestSimple;
