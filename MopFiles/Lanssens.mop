	output Real DiscmfHea_zone_A_0_Creative1 = max(0, TSetHea - T_zone__A_0_Creative1);
	output Real DiscmfCoo_zone_A_0_Creative1 = max(0, -TSetCoo + T_zone__A_0_Creative1);
