				+ DiscmfCoo_zone_G_1_Creative1^2
				+ DiscmfCoo_zone_G_2_App1^2
				+ DiscmfCoo_zone_G_2_App2^2
				+ DiscmfCoo_zone_G_3_App1^2
				+ DiscmfCoo_zone_G_3_App2^2
				+ DiscmfCoo_zone_G_4_App1^2
				+ DiscmfCoo_zone_G_4_App2^2
