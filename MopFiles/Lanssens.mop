    ////////////////////////////////
    
    //Overall //

	output Modelica.Units.NonSI.Temperature_degC T_zone__A_0_Creative1 = Modelica.Units.Conversions.to_degC(zone__A_0_Creative1.TSensor) "";
	output Modelica.Units.NonSI.Temperature_degC T_zone__A_0_UC_Gang1 = Modelica.Units.Conversions.to_degC(zone__A_0_UC_Gang1.TSensor) "";
	output Modelica.Units.NonSI.Temperature_degC T_zone__A_1_App1 = Modelica.Units.Conversions.to_degC(zone__A_1_App1.TSensor) "";
