				+ DiscmfHea_zone_F_1_App2^2
				+ DiscmfHea_zone_F_2_App1^2
				+ DiscmfHea_zone_F_2_App2^2
				+ DiscmfHea_zone_F_3_App1^2
				+ DiscmfHea_zone_F_3_App2^2
				+ DiscmfHea_zone_F_4_App1^2
