				+ DiscmfCoo_zone_G_5_App2^2
				+ DiscmfCoo_zone_G_6_App1^2
				+ DiscmfCoo_zone_G_6_App2^2
				+ DiscmfCoo_zone_G_7_App1^2
				+ DiscmfCoo_zone_G_7_App2^2);

	/// Overall objective ///
	output Real ObjInt = ObjIntComfSCoo + ObjIntComfSHea;



