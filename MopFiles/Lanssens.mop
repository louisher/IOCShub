optimization Lanssens(objectiveIntegrand=ObjInt, startTime=0, finalTime=startTime+1, timeStep=3600, intervalLengths="24*1", tolerance=1e-1, truncationDelta=1e-2)
    extends ArtesMod.BuildingEnvelopes.project(addDummyEquation=false);


	///////////////////////////////////
	// Objective function definition //
	///////////////////////////////////


	/// Comfort ///
	output Real TSetHea = 21;
	output Real TSetCoo = 26;
	output Real weight_hea = 10000;
	output Real weight_coo = 10000;
	output Real ObjIntComfSHea = weight_hea*(
				DiscmfHea_zone_A_0_Creative1^2
				+ DiscmfHea_zone_A_1_App1^2
