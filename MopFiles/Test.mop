optimization Test(objectiveIntegrand=ObjInt, startTime=0, finalTime=startTime+1, timeStep=3600, intervalLengths="8760*1", tolerance=1e-1)
	extends IOCSmod.Optimization.Test(sim.filNam=Modelica.Utilities.Files.loadResource("modelica://IOCSmod/Resources/weatherdata//BEL_VLG_Uccle.064470_TMYx.2007-2021.mos"));
	
	output Real COP_bhp_A = bhp_A.bhp.COP;
	output Real QCon_bhp_A = bhp_A.bhp.QCon;
	output Real P_bhp_A = bhp_A.bhp.PEl;
	output Modelica.Units.NonSI.Temperature_degC TBhpEvaIn_A = Modelica.Units.Conversions.to_degC(bhp_A.senTBhpEvaIn.T) "";
	output Modelica.Units.NonSI.Temperature_degC TBhpEvaOut_A = Modelica.Units.Conversions.to_degC(bhp_A.senTBhpEvaOut.T) "";
	output Modelica.Units.SI.MassFlowRate m_flow_bhpEva_A = pum.m_flow;
	output Modelica.Units.SI.MassFlowRate m_flow_bhpCon_A = bhp_A.bhp.m2_flow;

	output Real mod_bhp_A = bhp_A.bhp.mod;
	output Real QCon_profile = bhp_A.bhp.Qcon_profile.y[1];
	output Real bhp_smoothmin = bhp_A.bhp.smoothMin;

	///////////////////////////////////
	// Objective function definition //
	///////////////////////////////////
	/// Overall objective ///
	output Real ObjInt = QCon_profile;
	

end Test;
